{
    "name": "x402 Finance API",
    "description": "Live, aggressively cached real-time cryptocurrency price data protected by the x402 micropayment protocol. Returns current USD prices for any CoinGecko-supported asset.",
    "version": "1.0.0",
    "protocol": "x402",
    "network": "base-sepolia",
    "payment": {
        "asset": "USDC",
        "amount": "0.01",
        "exact": true
    },
    "endpoint": "https://x402-finance-api.onrender.com/crypto/{symbol}",
    "method": "GET",
    "headers": {
        "x-payment-tx": "Transaction hash of exact 0.01 USDC transfer"
    },
    "features": [
        "30-second in-memory cache with stale-while-revalidate",
        "Strict on-chain payment verification",
        "High reliability vs ghost endpoints",
        "Single-asset path parameter design"
    ],
    "documentation": {
        "agent_guide": "https://github.com/lokixc84/x402-finance-api/blob/main/AGENT_GUIDE.md",
        "llms_txt": "https://github.com/lokixc84/x402-finance-api/blob/main/llms.txt",
        "repository": "https://github.com/lokixc84/x402-finance-api"
    },
    "status": "live",
    "last_verified": "2026-07-20"
}